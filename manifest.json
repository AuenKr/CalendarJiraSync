{
  "manifest_version": 3,
  "name": "Calendar Jira Sync",
  "version": "1.1.5",
  "description": "Sync Jira tasks with Google Calendar",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://calendar.google.com/*",
    "https://*.atlassian.net/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Calendar Jira Sync",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "options_page": "setup.html",
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*"
      ],
      "matches": [
        "https://calendar.google.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
